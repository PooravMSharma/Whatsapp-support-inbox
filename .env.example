NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/wa_platform
REDIS_URL=redis://127.0.0.1:6379

# You invent this string; paste the same one into the Meta webhook config.
META_VERIFY_TOKEN=change-me-to-something-random
# Meta App Dashboard -> Settings -> Basic -> App Secret
META_APP_SECRET=
META_GRAPH_VERSION=v20.0

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
